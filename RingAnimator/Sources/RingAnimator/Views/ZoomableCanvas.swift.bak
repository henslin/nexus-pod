// PAUSED WORK — pinch-to-zoom on the phone mockup preview.
//
// This file is deliberately named `.swift.bak`, NOT `.swift` — SwiftPM only
// compiles `.swift` files, so this is inert, reference-only code, not part
// of the build. It's everything that was wired into `PhoneMockupView.swift`
// at the point this work was paused, preserved so it can be picked back up
// without redoing the investigation. To resume: rename this file back to
// `ZoomableCanvas.swift`, and re-wire `PhoneMockupView.body` to use
// `ZoomableCanvas` again instead of rendering `deviceFrame` directly (see
// git history / this file's own contents for exactly what that wiring
// looked like).
//
// THE PROBLEM: trackpad pinch-to-zoom (and even a plain double-click, via a
// real `NSClickGestureRecognizer`) never registers at all on the phone
// mockup preview — no visual response, and — critically — none of this
// file's own diagnostic `NSLog` calls for magnify-start/magnify-end/double-
// click ever fire either. Not "zooms wrong," not "janky" — completely
// silent, no event ever seems to arrive.
//
// WHAT'S BEEN RULED OUT (each confirmed via real console output/testing,
// not just reasoning):
//   1. SwiftUI's own `MagnificationGesture`/`DragGesture` — never fired.
//   2. A bare `NSMagnificationGestureRecognizer` on a plain `NSView` —
//      also never fired.
//   3. A real `NSScrollView` with `allowsMagnification = true` (this
//      file's `ZoomableCanvas`) — the correct, Apple-supported mechanism
//      (same one Preview/Photos/Xcode use) — still never fired, despite:
//        - the view's actual `NSView.frame` confirmed correct and non-zero
//          via `NSView.frameDidChangeNotification` logging (e.g.
//          `(0, 0, 462, 934)`, exactly matching the intended content size)
//        - a visible red background tint confirmed to visually line up
//          exactly with the phone mockup on screen
//        - `updateNSView` confirmed to fire only ONCE (not dozens of
//          times/sec from the ring's animation), ruling out a theory that
//          reassigning `NSHostingView.rootView` at high frequency was
//          disrupting in-progress gesture recognition
//   4. `PreviewTab`'s outer `ScrollView` as an ancestor — removed
//      entirely (see `ContentView.swift` git history for the
//      GeometryReader+ScrollView-wrapping-both-panes structure that used
//      to exist); pinch still didn't work with it gone.
//   5. `NavigationSplitView`'s and `ContentView`'s `HSplitView`'s own
//      internal `NSSplitView`s as ancestors — tested via `ZoomDebugSheet`
//      below, which puts the exact same `ZoomableCanvas` mechanism inside
//      a `.sheet` (a separate AppKit window, no split-view ancestors at
//      all). Still completely silent — no magnify/click logs, "the
//      gradient didn't zoom." This was the most conclusive test: it rules
//      out EVERY theory about this app's SwiftUI view-hierarchy nesting.
//
// TRACKPAD ITSELF IS FINE: pinch-to-zoom confirmed working normally in
// Preview.app and Safari on the same machine, same trackpad, around the
// same time as this testing.
//
// NEXT THING TO TRY (not yet tested): all of the above testing happened by
// running the app directly from Xcode (⌘R) as a bare SwiftPM executable
// target. `Package.swift` has NO mechanism (no linker-embedded Info.plist,
// no `resources:`/`GENERATE_INFOPLIST_FILE`-equivalent) wiring
// `RingAnimator/Packaging/Info.plist` into that kind of run — that
// Info.plist is only actually used by `Packaging/build_and_sign.sh` when
// assembling the real, signed `.app` bundle for distribution (the one used
// for sharing the Mac app via Slack). Every pinch test so far has been
// against Xcode's bare debug launch, not the properly-packaged app. Worth
// testing pinch against a freshly-built `Ring Pod.app` from
// `build_and_sign.sh` (no need to wait for notarization — an ad-hoc/dev
// signature is enough to test locally on the same Mac) before investigating
// further code-level theories. If pinch suddenly works in the packaged
// app, the fix is likely adding the missing Info.plist wiring to
// `Package.swift` for debug runs too (or just accepting that zoom needs to
// be tested via the packaged app), not any further gesture-handling code.
//
// ============================================================================

import SwiftUI
import AppKit
import RingAnimatorCore

/// Hosts SwiftUI `content` inside a real `NSScrollView` with
/// `allowsMagnification` turned on — see `PhoneMockupView`'s type doc
/// comment for why this replaced two earlier SwiftUI-gesture-based
/// attempts. `content` is rendered at a fixed `contentSize`, matching
/// exactly the `.frame(width:height:)` the caller applies to this view, so
/// the document view exactly fills the scroll view's visible area at rest
/// (magnification 1) — no leftover empty space to accidentally pin the
/// phone mockup into a corner instead of centering it, which is what a
/// document view smaller than its clip view would otherwise do by default.
private struct ZoomableCanvas<Content: View>: NSViewRepresentable {
    let contentSize: CGSize
    let minMagnification: CGFloat
    let maxMagnification: CGFloat
    let restMagnification: CGFloat
    @ViewBuilder var content: () -> Content

    private var sizedContent: AnyView {
        AnyView(content().frame(width: contentSize.width, height: contentSize.height))
    }

    func makeNSView(context: Context) -> NSScrollView {
        let hostingView = NSHostingView(rootView: sizedContent)
        hostingView.frame = CGRect(origin: .zero, size: contentSize)

        let scrollView = NSScrollView()
        // TEMPORARY — diagnostic only, remove once pinch-to-zoom is
        // confirmed working. A visible tint over exactly this view's real
        // AppKit bounds, so we can see whether the interactive region
        // actually lines up with the phone mockup on screen (rules out a
        // silent sizing/hit-testing mismatch between what's drawn and
        // what's actually receiving events).
        scrollView.drawsBackground = true
        scrollView.backgroundColor = NSColor.systemRed.withAlphaComponent(0.12)
        scrollView.hasHorizontalScroller = false
        scrollView.hasVerticalScroller = false
        scrollView.allowsMagnification = true
        scrollView.minMagnification = minMagnification
        scrollView.maxMagnification = maxMagnification
        scrollView.magnification = restMagnification
        scrollView.documentView = hostingView

        let doubleClick = NSClickGestureRecognizer(
            target: context.coordinator,
            action: #selector(Coordinator.handleDoubleClick)
        )
        doubleClick.numberOfClicksRequired = 2
        scrollView.addGestureRecognizer(doubleClick)

        context.coordinator.hostingView = hostingView
        context.coordinator.scrollView = scrollView
        context.coordinator.restMagnification = restMagnification

        // TEMPORARY — diagnostic only. Logs to Xcode's console so we can
        // see, definitively, whether magnify events ever reach this
        // NSScrollView at all — separates "the gesture never arrives here"
        // from "it arrives but something about the visual result is wrong,"
        // which need completely different fixes.
        NSLog("🔍 ZoomableCanvas.makeNSView — created, contentSize=\(contentSize), frame=\(scrollView.frame)")
        NotificationCenter.default.addObserver(
            forName: NSScrollView.willStartLiveMagnifyNotification,
            object: scrollView,
            queue: .main
        ) { _ in
            NSLog("🔍 ZoomableCanvas — willStartLiveMagnify (pinch detected)")
        }
        NotificationCenter.default.addObserver(
            forName: NSScrollView.didEndLiveMagnifyNotification,
            object: scrollView,
            queue: .main
        ) { _ in
            NSLog("🔍 ZoomableCanvas — didEndLiveMagnify, magnification now \(scrollView.magnification)")
        }
        // TEMPORARY — diagnostic. `makeNSView` logging a zero frame is
        // normal/expected (SwiftUI hasn't applied layout yet at that
        // instant) — this instead logs the *real* frame the moment AppKit
        // actually resolves it, so we can confirm this view ever gets a
        // genuine non-zero, correctly-hit-testable frame at all (as
        // opposed to only ever looking right visually while its actual
        // `NSView.frame` — what hit-testing uses — stays wrong).
        scrollView.postsFrameChangedNotifications = true
        NotificationCenter.default.addObserver(
            forName: NSView.frameDidChangeNotification,
            object: scrollView,
            queue: .main
        ) { _ in
            NSLog("🔍 ZoomableCanvas — frameDidChange, now \(scrollView.frame)")
        }

        return scrollView
    }

    func updateNSView(_ scrollView: NSScrollView, context: Context) {
        context.coordinator.restMagnification = restMagnification

        // The high-frequency-re-render theory is ruled out: the console
        // confirmed `updateNSView` fires exactly once, not dozens of
        // times/sec, so reassigning `rootView` here was never the problem.
        // Restored — this is what makes the Light/Dark and App UI toggles
        // actually reach the hosted content.
        context.coordinator.updateCount += 1
        if context.coordinator.updateCount == 1 || context.coordinator.updateCount % 60 == 0 {
            NSLog("🔍 ZoomableCanvas.updateNSView — call #\(context.coordinator.updateCount)")
        }
        context.coordinator.hostingView?.rootView = sizedContent
    }

    func makeCoordinator() -> Coordinator {
        Coordinator()
    }

    /// `@MainActor` explicitly — the compiler otherwise flags every touch
    /// of `scrollView.magnification`/`.animator()` here as an unsafe
    /// reference to a main-actor-isolated AppKit member from a nonisolated
    /// context (visible as warnings in Xcode's Issue Navigator: "Main
    /// actor-isolated property 'magnification' can not be referenced...").
    /// In practice every one of these calls already only ever runs on the
    /// main thread — gesture-recognizer target-action and this file's
    /// `NotificationCenter` observers (registered with `queue: .main`) both
    /// guarantee that — so this annotation just tells the compiler what's
    /// already true at runtime, cleanly resolving the warnings rather than
    /// papering over them.
    @MainActor
    final class Coordinator: NSObject {
        weak var hostingView: NSHostingView<AnyView>?
        weak var scrollView: NSScrollView?
        var restMagnification: CGFloat = 1
        /// TEMPORARY — diagnostic only. See `updateNSView`.
        var updateCount = 0

        /// Animates back to actual size — mirrors what a `resetZoom()`
        /// helper used to do by hand when zoom was tracked in SwiftUI
        /// `@State`; now it's just telling the scroll view itself to
        /// animate its own `magnification` back down.
        @objc func handleDoubleClick() {
            // TEMPORARY — diagnostic only. If this never logs either, the
            // problem isn't magnify-specific — nothing about this view is
            // receiving gesture events at all, which points at hit-testing/
            // view-hierarchy rather than anything magnify-related.
            NSLog("🔍 ZoomableCanvas — double-click received")
            guard let scrollView else { return }
            NSAnimationContext.runAnimationGroup { animationContext in
                animationContext.duration = 0.3
                animationContext.allowsImplicitAnimation = true
                scrollView.animator().magnification = restMagnification
            }
        }
    }
}

/// TEMPORARY — diagnostic only. A minimal, self-contained pinch-zoom test
/// presented via `.sheet` — a separate AppKit window, with neither
/// `NavigationSplitView`'s internal split view nor `ContentView`'s
/// `HSplitView` as an ancestor. Uses the exact same `ZoomableCanvas`
/// mechanism as the real phone mockup, just wrapping a plain gradient box
/// instead of `deviceFrame`, to isolate "does this mechanism work at all,
/// outside this app's specific view nesting" from everything else.
private struct ZoomDebugSheet: View {
    @Environment(\.dismiss) private var dismiss

    var body: some View {
        VStack(spacing: 16) {
            Text("Isolated pinch-zoom test").font(.headline)
            Text("This lives in a .sheet — no NavigationSplitView or HSplitView ancestor. Try pinching and double-clicking the box below.")
                .font(.caption)
                .foregroundStyle(.secondary)
                .multilineTextAlignment(.center)
                .frame(maxWidth: 320)

            ZoomableCanvas(
                contentSize: CGSize(width: 280, height: 280),
                minMagnification: 0.25,
                maxMagnification: 5,
                restMagnification: 1
            ) {
                RoundedRectangle(cornerRadius: 24, style: .continuous)
                    .fill(LinearGradient(colors: [.blue, .purple], startPoint: .topLeading, endPoint: .bottomTrailing))
                    .overlay {
                        Text("Pinch me")
                            .font(.title2.bold())
                            .foregroundStyle(.white)
                    }
            }
            .frame(width: 280, height: 280)

            Button("Close") { dismiss() }
                .keyboardShortcut(.cancelAction)
        }
        .padding(32)
        .frame(width: 400, height: 460)
    }
}
