# macOS
.DS_Store

# SwiftPM
.build/
.swiftpm/

# Xcode
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xcuserdatad/
xcshareddata/IDEWorkspaceChecks.plist

# Xcode's clang index store, which it drops inside the .xcodeproj as a
# literal "-Xcc" directory. Thousands of binary .o/.pcm index units that
# are rewritten on every build — build state, not source. Unanchored so it
# matches under any .xcodeproj.
-Xcc/

# Build/packaging output — the signed .app and its zips are generated by
# Packaging/build_and_sign.sh and release.sh, not source. Unanchored (no
# leading slash) so it matches at any depth — RingAnimator/Packaging/stage/
# is where these actually land, not a top-level Packaging/ folder.
RingAnimator.app/
**/Packaging/stage/
*.zip

# Stray/junk files from earlier manual downloads — not source, safe to
# leave untracked rather than delete outright.
ziIlfxzQ
ziMHbVVr
